---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { getLanguages, getNavigation, getPageUrl, getUi, LOCALES, parseEntry } from '../i18n'

interface Props {
  entry: CollectionEntry<'docs'>
}

const { entry } = Astro.props
const { locale, key } = parseEntry(entry)
const entries = await getCollection('docs')
const navigation = getNavigation(entries, locale)
const languages = getLanguages(entries, key)
const ui = getUi(locale)
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{entry.data.title} · diglot × Astro</title>
    <meta name="description" content={entry.data.description} />
    {languages.map(page => <link rel="alternate" hreflang={page.locale} href={getPageUrl(page)} />)}
  </head>
  <body>
    <header class="example-header">
      <a class="example-brand" href={getPageUrl({ locale, key: '' })}>
        <img src="/favicon.svg" alt="" width="28" height="28" />
        <span>diglot <span aria-hidden="true">×</span> Astro</span>
      </a>
      <nav class="example-pages" aria-label={ui.pages}>
        {navigation.map(page => (
          <a href={getPageUrl(page)} aria-current={page.key === key ? 'page' : undefined}>{page.entry.data.title}</a>
        ))}
      </nav>
      <nav class="example-languages" aria-label={ui.languages}>
        {languages.map(page => (
          <a href={getPageUrl(page)} hreflang={page.locale} lang={page.locale} aria-current={page.locale === locale ? 'true' : undefined}>{LOCALES[page.locale]}</a>
        ))}
      </nav>
    </header>
    <main class="example-content">
      <h1>{entry.data.title}</h1>
      <p class="example-lead">{entry.data.description}</p>
      <slot />
    </main>
    <footer class="example-footer">
      <a href="https://github.com/danielroe/diglot">{ui.footer}</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --example-bg: #0d0f17;
    --example-surface: #161a26;
    --example-border: #262c3d;
    --example-text: #e6e8f0;
    --example-muted: #9aa1b5;
    --example-accent: #c084fc;
    --example-gradient: linear-gradient(83deg, #a855f7 0%, #f97316 100%);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background:
      radial-gradient(60rem 30rem at 50% -10rem, rgb(168 85 247 / 0.18), transparent 70%),
      var(--example-bg);
    color: var(--example-text);
    font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, 'Hiragino Sans', 'Noto Sans JP', sans-serif;
    line-height: 1.7;
    min-block-size: 100vh;
  }

  a {
    color: var(--example-accent);
  }

  code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.9em;
  }

  :not(pre) > code,
  kbd {
    padding: 0.1em 0.4em;
    border: 1px solid var(--example-border);
    border-radius: 0.375rem;
    background: var(--example-surface);
  }

  pre {
    padding: 1rem 1.25rem;
    border: 1px solid var(--example-border);
    border-radius: 0.75rem;
    overflow-x: auto;
  }
</style>

<style>
  .example-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding: 0.875rem max(1.25rem, calc((100vw - 52rem) / 2));
    border-block-end: 1px solid var(--example-border);
    background: rgb(13 15 23 / 0.8);
    backdrop-filter: blur(12px);
  }

  /* On a phone, the wrapped header would cover too much of the page to stay on screen. */
  @media (min-width: 48rem) {
    .example-header {
      position: sticky;
      inset-block-start: 0;
    }
  }

  .example-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--example-text);
    font-weight: 700;
    text-decoration: none;
  }

  .example-pages,
  .example-languages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .example-languages {
    margin-inline-start: auto;
  }

  nav a {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    color: var(--example-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--example-text);
  }

  nav a[aria-current] {
    background: var(--example-surface);
    color: var(--example-text);
  }

  .example-content {
    max-inline-size: 52rem;
    margin-inline: auto;
    padding: 3rem 1.25rem 4rem;
  }

  h1 {
    margin: 0;
    background: var(--example-gradient);
    background-clip: text;
    color: transparent;
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    line-height: 1.15;
  }

  .example-lead {
    margin-block: 0.75rem 2.5rem;
    color: var(--example-muted);
    font-size: 1.2rem;
  }

  .example-footer {
    padding: 2rem 1.25rem;
    border-block-start: 1px solid var(--example-border);
    text-align: center;
  }

  .example-footer a {
    color: var(--example-muted);
  }
</style>
