{
  "name": "@diglot/store",
  "type": "module",
  "version": "0.1.0",
  "description": "git record store for diglot translations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielroe/diglot.git",
    "directory": "packages/store"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@diglot/core": "workspace:*",
    "c12": "^4.0.0-rc.4",
    "pathe": "^2.0.3",
    "yaml": "^2.9.1"
  }
}
