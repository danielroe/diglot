{
  "name": "@diglot/x18n",
  "type": "module",
  "version": "0.1.4",
  "description": "x18n plugin for diglot translation stores",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielroe/diglot.git",
    "directory": "packages/x18n"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ]
    }
  },
  "bin": {
    "diglot-x18n": "./bin/diglot-x18n.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@x18n/core": "^0.1.10"
  },
  "dependencies": {
    "@diglot/comark": "workspace:*",
    "@diglot/core": "workspace:*",
    "@diglot/mdast": "workspace:*",
    "@diglot/store": "workspace:*",
    "citty": "^0.2.2",
    "pathe": "^2.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@x18n/core": "0.1.10",
    "@x18n/node": "0.1.10"
  }
}
