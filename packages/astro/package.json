{
  "name": "@diglot/astro",
  "type": "module",
  "version": "0.2.2",
  "description": "Astro content loader for diglot translations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielroe/diglot.git",
    "directory": "packages/astro"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "dependencies": {
    "@diglot/core": "workspace:*",
    "@diglot/mdast": "workspace:*",
    "@diglot/store": "workspace:*",
    "devalue": "^6.0.3",
    "pathe": "^2.0.3",
    "satteri": "^0.11.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/mdx": "8.1.5",
    "astro": "7.4.11",
    "vite": "8.3.6"
  }
}
