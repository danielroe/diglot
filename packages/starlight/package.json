  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.0.0"
  },
  "dependencies": {
    "@diglot/astro": "workspace:*",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.42.11",
    "astro": "7.4.11"
  }
}
