{
  "name": "@diglot/starlight",
  "type": "module",
  "version": "0.2.2",
  "description": "Starlight plugin for diglot translations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielroe/diglot.git",
    "directory": "packages/starlight"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
