{
  "name": "diglot-monorepo",
  "type": "module",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielroe/diglot.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "vitest dev",
    "docs:dev": "pnpm --filter diglot-docs dev",
    "docs:build": "pnpm --filter diglot-docs build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "corpus": "node scripts/corpus.ts",
    "test": "pnpm test:unit && pnpm test:types && pnpm test:knip",
    "test:unit": "vitest",
    "test:knip": "knip",
    "test:versions": "installed-check -d --no-workspaces",
    "test:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@arethetypeswrong/core": "0.18.5",
    "@diglot/code": "workspace:*",
    "@diglot/comark": "workspace:*",
    "@diglot/core": "workspace:*",
    "@diglot/mdast": "workspace:*",
    "@diglot/store": "workspace:*",
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "installed-check": "11.0.0",
    "knip": "6.44.2",
    "nano-staged": "1.0.2",
    "pkg-pr-new": "0.0.93",
    "publint": "0.3.25",
    "simple-git-hooks": "2.14.0",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,json,yml,yaml,md,.*rc}": [
      "pnpm eslint --fix"
    ]
  }
}
